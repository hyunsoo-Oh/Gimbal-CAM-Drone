#include "w25qxx.h"

static void nCS_pinHigh()
{
	HAL_GPIO_WriteLow(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);
}

static void nCS_pinClear()
{
	HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);
}

static void spi_write(uint8_t *pData, uint16_t size)
{
	HAL_SPI_Transmit(&spi1, pData, size, 10);
}

static void spi_read()
{
	HAL_SPI_Receive(&spi1, pData, size, 10);
}
